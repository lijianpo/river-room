    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@poker/contracts": "workspace:*",
    "@poker/game-engine": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.2",
    "socket.io": "^4.8.1",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^0.6.0",
    "@types/node": "^24.10.1",
    "socket.io-client": "^4.8.1",
